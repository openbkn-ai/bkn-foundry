│   ├── pod.bkn
│   └── service.bkn
├── relation_types/
│   ├── pod_belongs_node.bkn
│   └── service_routes_pod.bkn
├── action_types/
│   ├── cordon_node.bkn
│   └── restart_pod.bkn
└── concept_groups/
    └── k8s.bkn
```
