{
  "input_schema": {
    "type": "object",
    "properties": {
      "response_format": {
        "type": "string",
        "enum": [
          "json",
          "toon"
        ],
        "default": "toon",
        "description": "文本格式：json 或 toon，默认 toon"
      },
      "kn_id": {
        "type": "string",
        "description": "知识网络 ID，来自 list_knowledge_networks。"
      },
      "branch": {
        "type": "string",
        "description": "分支名，可选，默认 main。"
      },
      "query": {
        "type": "string",
        "description": "只读 M19 的 BKN 有界实现：MATCH/OPTIONAL MATCH/WITH/UNWIND/RETURN 与 UNION；列表/map/CASE、推导式与量词、模式谓词和相关/嵌套 EXISTS；一般与统计聚合、已注册标量和时间函数、整数参数化分页。支持无标签节点、无类型/多类型关系、命名无向关系、固定/变长路径及 nodes/relationships/length。显式路径至多八跳，无界路径若可超过八跳则整条失败。节点仅有一个对象类，direct 关系按类型与端点标识，无独立属性与平行边身份；properties(r) 为空，r.property 为 null。所有分支/阶段/子查询提前授权，图值来源保留，内部依赖不扩大 object_properties 显式快照。复杂模式先有界扫描再关联，小结果也可能超限。全请求共享 9999 工作行、8 MiB、79992 次迭代/比较和 30 秒；每模式至多 64 个类型观察。写操作和过程调用拒绝；不宣称完整 TCK 兼容。"
      },
      "parameters": {
        "type": "object",
        "additionalProperties": true,
        "description": "查询里的 $name 值，支持 JSON 标量、null、列表和 map；嵌套最多 32 层并受载荷预算约束。简单同类标量 IN 列表保留既有 SQL 下推路径，复杂/空/含 null 的列表通过有界表达式求值。参数永远不会变成标签、关系类型、属性名或物理 SQL 标识符。 数字参数名如 $0 对应 JSON 键 \"0\"，不表示参数位置。"
      },
      "result_format": {
        "type": "string",
        "enum": [
          "graph_v1"
        ],
        "description": "可选显式选择 graph_v1 类型化结果。语法能力不依赖此字段；缺省时根据查询自动选择原表格或类型化结果。需要有界求值的查询最多读取 9999 条候选匹配，再读一行探测是否超预算；8 MiB 组装计费预算，30 秒超时，超预算整体失败。DISTINCT/排序/SKIP/LIMIT 在分组聚合后执行。",
        "x-ptc-keyword-only": true
      },
      "object_properties": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "description": "仅 graph_v1：按节点变量指定快照属性清单，均须完整读取权限。默认只返回完整类型身份；关系证据另包含获准的连接依据。",
        "x-ptc-keyword-only": true
      }
    },
    "required": [
      "kn_id",
      "query"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "columns": {
        "type": "array",
        "description": "输出列，顺序与 RETURN 一致；name 是 AS 别名，没写别名时是属性引用的原文。",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "type": {
              "type": "string"
            }
          }
        }
      },
      "entries": {
        "type": "array",
        "description": "结果行，按列名取值。",
        "items": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "permission_guidance": {
        "type": "array",
        "description": "权限说明列表。仅当字段权限拒绝了查询，或行访问范围收窄了成功结果时出现；每个受影响对象类一项。逐项把 message 告诉用户，并提供对应申请链接。",
        "items": {
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "resource": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "kn_id": {
                  "type": "string"
                },
                "ot_id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              }
            },
            "shortfalls": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "scope": {
                    "type": "string",
                    "enum": [
                      "grant",
                      "row_filter",
                      "property_grants"
                    ]
                  },
                  "operations": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "properties": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "request_permission_url": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "result_format": {
        "type": "string",
        "enum": [
          "graph_v1"
        ]
      },
      "value_types": {
        "type": "object",
        "additionalProperties": true,
        "description": "按返回列名提供对象、关系、map、list 及标量的递归类型描述。"
      },
      "execution": {
        "type": "object",
        "properties": {
          "match_rows": {
            "type": "integer"
          },
          "match_complete": {
            "type": "boolean"
          },
          "evidence_complete": {
            "type": "boolean"
          },
          "conclusions_limited": {
            "type": "boolean"
          },
          "candidate_rows": {
            "type": "integer",
            "description": "源候选行数；分阶段执行累计物理 MATCH 观察行数，UNION 按分支求和。match_rows 为进入最终投影的逻辑行数，统计在最终聚合和 UNION 去重之前。"
          }
        }
      }
    }
  }
}
