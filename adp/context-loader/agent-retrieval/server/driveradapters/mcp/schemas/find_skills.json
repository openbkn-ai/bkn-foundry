{
  "input_schema": {
    "type": "object",
    "required": [
      "kn_id",
      "object_type_id"
    ],
    "properties": {
      "response_format": {
        "type": "string",
        "enum": [
          "json",
          "toon"
        ],
        "default": "toon",
        "description": "文本格式：json 或 toon，默认 toon"
      },
      "kn_id": {
        "type": "string",
        "description": "知识网络 ID（必填）。召回范围是该网络已挂载的 Skill。"
      },
      "object_type_id": {
        "type": "string",
        "description": "**已废弃，不再影响结果**（0.1.5 起）。仍需传入以保持调用签名稳定，传任意存在或不存在的对象类 ID 都不会报错。挂载归属于知识网络分支而非某个对象类。",
        "deprecated": true
      },
      "instance_identities": {
        "type": "array",
        "description": "**已废弃，不再影响结果**（0.1.5 起）。仍然接受。",
        "items": {
          "type": "object",
          "additionalProperties": true
        },
        "deprecated": true
      },
      "skill_query": {
        "type": "string",
        "description": "可选。在该网络已挂载的 Skill 内按相关性排序。留空则按挂载顺序列出全部已挂载 Skill。"
      },
      "top_k": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20,
        "default": 10,
        "description": "返回的最大技能数量，默认 10"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "entries": {
        "type": "array",
        "description": "匹配的技能列表",
        "items": {
          "type": "object",
          "properties": {
            "skill_id": {
              "type": "string",
              "description": "技能 ID"
            },
            "name": {
              "type": "string",
              "description": "技能名称"
            },
            "description": {
              "type": "string",
              "description": "技能描述"
            }
          }
        }
      },
      "message": {
        "type": "string",
        "description": "空结果说明信息，仅当 entries 为空时出现，说明原因和下一步建议"
      }
    }
  }
}
