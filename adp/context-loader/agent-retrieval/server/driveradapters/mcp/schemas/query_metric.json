{
  "input_schema": {
    "type": "object",
    "properties": {
      "response_format": {
        "type": "string",
        "enum": ["json", "toon"],
        "default": "toon",
        "description": "文本格式：json 或 toon，默认 toon"
      },
      "kn_id": {
        "type": "string",
        "description": "知识网络 ID，来自 list_knowledge_networks 或 get_kn_detail。"
      },
      "metric_id": {
        "type": "string",
        "description": "对象指标 ID，取自 get_object_types 返回的 related_metrics[].id。"
      },
      "version": {
        "type": "integer",
        "minimum": 1,
        "description": "已发布且不可变的对象指标版本，取自 related_metrics[].version；不能省略或猜测最新版本。"
      },
      "query": {
        "type": "object",
        "additionalProperties": false,
        "description": "仅包含已发布指标允许的运行时选择；固定业务限定与统计粒度由指标定义决定。",
        "properties": {
          "instance_identities": {
            "type": "array",
            "items": {"type": "object", "additionalProperties": true},
            "description": "可选的对象实例身份列表。"
          },
          "filter": {
            "type": "object",
            "additionalProperties": true,
            "description": "符合对象指标 V1 条件 AST 的运行时过滤条件。"
          },
          "analysis_dimensions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["object_type_id", "property_name"],
              "properties": {
                "object_type_id": {"type": "string"},
                "property_name": {"type": "string"},
                "relation_path_alias": {"type": "string"}
              },
              "additionalProperties": false
            },
            "description": "从已发布定义的 query_capabilities.analysis_dimensions 选择属性引用。"
          },
          "time": {
            "type": "object",
            "required": ["start", "end"],
            "additionalProperties": false,
            "properties": {
              "start": {"type": "integer", "description": "起始时间，Unix 毫秒"},
              "end": {"type": "integer", "description": "结束时间，Unix 毫秒"}
            }
          }
        }
      }
    },
    "required": ["kn_id", "metric_id", "version"]
  },
  "output_schema": {
    "type": "object",
    "required": ["kn_id", "metric_id", "version", "model", "entries", "status", "overall_ms"],
    "properties": {
      "kn_id": {"type": "string"},
      "metric_id": {"type": "string"},
      "version": {"type": "integer"},
      "model": {"type": "object", "additionalProperties": true},
      "entries": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "instance_identity": {"type": "object", "additionalProperties": true},
            "dimensions": {"type": "object", "additionalProperties": true},
            "time": {"type": "integer"},
            "value": {},
            "status": {"type": "string", "enum": ["ok", "no_data", "unavailable"]}
          }
        }
      },
      "status": {"type": "string", "enum": ["ok", "no_data", "unavailable", "partial"]},
      "warnings": {"type": "array", "items": {"type": "string"}},
      "overall_ms": {"type": "integer"}
    }
  }
}
