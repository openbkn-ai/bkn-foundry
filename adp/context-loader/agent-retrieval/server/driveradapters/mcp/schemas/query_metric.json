{
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "definitions": {
      "property_ref": {
        "type": "object",
        "additionalProperties": false,
        "required": ["object_type_id", "property_name"],
        "properties": {
          "object_type_id": {"type": "string", "minLength": 1, "description": "对象类 ID。"},
          "property_name": {"type": "string", "minLength": 1, "description": "对象类的数据属性名。"},
          "relation_path_alias": {"type": "string", "minLength": 1, "description": "通过已发布关系路径访问属性时使用的路径别名。"}
        }
      },
      "property_operand": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "property_ref"],
        "properties": {
          "source": {"const": "property", "description": "属性操作数固定为 property。"},
          "property_ref": {"$ref": "#/definitions/property_ref"}
        }
      },
      "literal_operand": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "value_type", "value"],
        "properties": {
          "source": {"const": "literal", "description": "字面量操作数固定为 literal。"},
          "value_type": {
            "type": "string",
            "enum": ["int64", "decimal", "boolean", "string", "date", "datetime", "duration"],
            "description": "字面量物理类型：date 使用 YYYY-MM-DD，datetime 使用 RFC 3339，duration 使用数值。"
          },
          "value": {"description": "值必须与 value_type 匹配；int64 必须是整数。"}
        }
      },
      "operand": {
        "oneOf": [
          {"$ref": "#/definitions/property_operand"},
          {"$ref": "#/definitions/literal_operand"}
        ]
      },
      "scalar_predicate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_type", "left", "comparison_operator", "right"],
        "properties": {
          "node_type": {"const": "predicate"},
          "left": {"$ref": "#/definitions/operand"},
          "comparison_operator": {
            "type": "string",
            "enum": ["eq", "neq", "gt", "gte", "lt", "lte", "contains", "not_contains", "starts_with", "ends_with", "before", "before_or_equal", "after", "after_or_equal"],
            "description": "单值比较操作符；right 必须且只能有一个操作数。"
          },
          "right": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/definitions/operand"}}
        }
      },
      "membership_predicate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_type", "left", "comparison_operator", "right"],
        "properties": {
          "node_type": {"const": "predicate"},
          "left": {"$ref": "#/definitions/operand"},
          "comparison_operator": {"type": "string", "enum": ["in", "not_in"], "description": "集合比较操作符；right 至少包含一个操作数。"},
          "right": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/operand"}}
        }
      },
      "range_predicate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_type", "left", "comparison_operator", "right"],
        "properties": {
          "node_type": {"const": "predicate"},
          "left": {"$ref": "#/definitions/operand"},
          "comparison_operator": {"type": "string", "enum": ["between", "not_between"], "description": "闭区间比较操作符；right 按下界、上界顺序包含两个操作数。"},
          "right": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/definitions/operand"}}
        }
      },
      "unary_predicate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_type", "left", "comparison_operator"],
        "properties": {
          "node_type": {"const": "predicate"},
          "left": {"$ref": "#/definitions/operand"},
          "comparison_operator": {
            "type": "string",
            "enum": ["is_empty", "is_not_empty", "is_null", "is_not_null", "is_true", "is_false"],
            "description": "一元比较操作符；不得传 right。"
          },
          "right": {"type": "array", "maxItems": 0}
        }
      },
      "predicate": {
        "oneOf": [
          {"$ref": "#/definitions/scalar_predicate"},
          {"$ref": "#/definitions/membership_predicate"},
          {"$ref": "#/definitions/range_predicate"},
          {"$ref": "#/definitions/unary_predicate"}
        ]
      },
      "boolean_group": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_type", "boolean_operator", "children"],
        "properties": {
          "node_type": {"const": "group"},
          "boolean_operator": {"type": "string", "enum": ["and", "or"], "description": "and/or 组合至少两个子条件。"},
          "children": {"type": "array", "minItems": 2, "items": {"$ref": "#/definitions/object_metric_condition"}}
        }
      },
      "not_group": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_type", "boolean_operator", "children"],
        "properties": {
          "node_type": {"const": "group"},
          "boolean_operator": {"const": "not", "description": "not 组合只能包含一个子条件。"},
          "children": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/definitions/object_metric_condition"}}
        }
      },
      "object_metric_condition": {
        "description": "递归条件 AST。节点只能是 predicate 或 group；运行时属性必须精确来自已发布指标 query_capabilities 的 analysis_dimensions 或 time_dimensions。",
        "oneOf": [
          {"$ref": "#/definitions/predicate"},
          {"$ref": "#/definitions/boolean_group"},
          {"$ref": "#/definitions/not_group"}
        ]
      }
    },
    "properties": {
      "response_format": {
        "type": "string",
        "enum": ["json", "toon"],
        "default": "toon",
        "description": "文本格式：json 或 toon，默认 toon"
      },
      "kn_id": {
        "type": "string",
        "description": "知识网络 ID，来自 list_knowledge_networks 或 get_kn_detail。"
      },
      "metric_id": {
        "type": "string",
        "description": "对象指标 ID，取自 get_object_types 返回的 related_metrics[].id。"
      },
      "version": {
        "type": "integer",
        "minimum": 1,
        "description": "已发布且不可变的对象指标版本，取自 related_metrics[].version；不能省略或猜测最新版本。"
      },
      "query": {
        "type": "object",
        "additionalProperties": false,
        "description": "仅包含已发布指标允许的运行时选择；固定业务限定与统计粒度由指标定义决定。",
        "properties": {
          "instance_identities": {
            "type": "array",
            "items": {"type": "object", "additionalProperties": true},
            "description": "可选的对象实例身份列表。"
          },
          "filter": {
            "$ref": "#/definitions/object_metric_condition",
            "description": "运行时属性过滤条件。属性引用必须来自该版本开放的 analysis_dimensions 或 time_dimensions；属性与字面量类型必须兼容。"
          },
          "group_by": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["object_type_id", "property_name"],
              "properties": {
                "object_type_id": {"type": "string"},
                "property_name": {"type": "string"},
                "relation_path_alias": {"type": "string"}
              },
              "additionalProperties": false
            },
            "description": "从已发布定义的 query_capabilities.analysis_dimensions 选择属性引用。"
          },
          "having": {
            "type": "object",
            "additionalProperties": false,
            "required": ["operator"],
            "properties": {
              "operator": {"type": "string", "enum": ["eq", "ne", "gt", "gte", "lt", "lte", "is_null", "is_not_null"]},
              "value": {"description": "最终指标值的比较值；is_null/is_not_null 时省略。"},
              "unit_code": {"type": "string", "description": "可选；必须与指标结果单位一致。"}
            },
            "description": "聚合完成后筛选最终指标值，不筛选源行或依赖指标。"
          },
          "order_by": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["field", "direction"],
              "properties": {
                "field": {"type": "string", "enum": ["value", "time", "dimension"]},
                "dimension": {"type": "object", "required": ["object_type_id", "property_name"], "properties": {"object_type_id": {"type": "string"}, "property_name": {"type": "string"}, "relation_path_alias": {"type": "string"}}},
                "direction": {"type": "string", "enum": ["asc", "desc"]}
              }
            },
            "description": "对最终指标结果排序，空值排在最后。"
          },
          "page_size": {"type": "integer", "minimum": 1, "maximum": 1000, "description": "可选的结果页大小；省略时返回全部结果。"},
          "cursor": {"type": "string", "description": "上一页 next_cursor；数据变化时需从第一页重试。"},
          "time": {
            "type": "object",
            "required": ["start", "end"],
            "additionalProperties": false,
            "description": "时间范围，起点与终点均为 Unix 毫秒。",
            "properties": {
              "start": {"type": "integer", "description": "起始时间，Unix 毫秒"},
              "end": {"type": "integer", "description": "结束时间，Unix 毫秒"}
            }
          },
          "bucket_selection": {
            "type": "object",
            "additionalProperties": false,
            "required": ["parent_query", "bucket_key"],
            "description": "继续下钻时传入上一层原样保留的 query 和该层结果返回的 bucket_key；不得自行构造桶键。",
            "properties": {
              "parent_query": {"$ref": "#/properties/query", "description": "上一步 query_metric 使用的完整 query。"},
              "bucket_key": {"type": "string", "description": "上一步结果条目返回的 bucket_key。"}
            }
          }
        }
      }
    },
    "required": ["kn_id", "metric_id", "version"]
  },
  "output_schema": {
    "type": "object",
    "required": ["kn_id", "metric_id", "version", "model", "entries", "status", "total_count", "overall_ms", "evaluated_at"],
    "properties": {
      "kn_id": {"type": "string", "description": "知识网络 ID。"},
      "metric_id": {"type": "string", "description": "对象指标 ID。"},
      "version": {"type": "integer", "description": "已发布的指标版本。"},
      "model": {"type": "object", "additionalProperties": true, "description": "已发布指标的结果模型。"},
      "entries": {
        "type": "array",
        "description": "带状态的指标结果条目。",
        "items": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "instance_identity": {"type": "object", "additionalProperties": true},
            "dimensions": {"type": "object", "additionalProperties": true},
            "dimension_cells": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["ref", "value"],
                "properties": {
                  "ref": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["object_type_id", "property_name"],
                    "properties": {
                      "object_type_id": {"type": "string"},
                      "property_name": {"type": "string"},
                      "relation_path_alias": {"type": "string"}
                    }
                  },
                  "value": {}
                }
              }
            },
            "time": {"type": "integer"},
            "time_bucket": {"type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": {"start": {"type": "integer"}, "end": {"type": "integer"}}},
            "value": {},
            "display_value": {"type": "string", "description": "数值结果的精确十进制文本，仅用于展示；value 保持原始 JSON 数值。"},
            "status": {"type": "string", "enum": ["ok", "no_data", "unavailable"]},
            "bucket_key": {"type": "string"},
            "available_actions": {"type": "array", "items": {"type": "string", "enum": ["filter", "drill", "participants", "context"]}}
          }
        }
      },
      "status": {"type": "string", "enum": ["ok", "no_data", "unavailable", "partial"], "description": "整体查询状态。"},
      "empty_reason": {"type": "string", "enum": ["filtered_out"], "description": "结果被 having 全部筛除时返回。"},
      "total_count": {"type": "integer", "description": "最终筛选后的完整结果行数。"},
      "next_cursor": {"type": "string", "description": "下一页游标。"},
      "warnings": {"type": "array", "items": {"type": "string"}, "description": "部分成功或不可用时的警告。"},
      "overall_ms": {"type": "integer", "description": "查询耗时，单位毫秒。"},
      "evaluated_at": {"type": "integer", "description": "结果计算时间，Unix 毫秒。"},
      "effective_window": {"type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": {"start": {"type": "integer"}, "end": {"type": "integer"}}}
    }
  }
}
