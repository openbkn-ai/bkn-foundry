{
  "input_schema": {
    "type": "object",
    "properties": {
      "response_format": {
        "type": "string",
        "enum": [
          "json",
          "toon"
        ],
        "default": "toon",
        "description": "文本格式：json 或 toon，默认 toon"
      },
      "kn_id": {
        "type": "string",
        "description": "知识网络 ID，来自 list_knowledge_networks 或 get_kn_detail，不可凭名称猜测。"
      },
      "at_id": {
        "type": "string",
        "description": "行动类型ID"
      },
      "_instance_identities": {
        "type": "array",
        "description": "修改或删除对象实例时明确指定的目标主键列表，从查询结果的 _instance_identity 提取。不能省略后依靠条件扫描；工具调用和新建对象不传此字段。",
        "items": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "relation_target": {
        "type": "object",
        "description": "建立或解除关系时明确指定一对起点和终点实例。身份字段由两端对象类的唯一标识定义决定，值从实例查询结果取得；不能由适用条件推断。",
        "properties": {
          "source_identity": {
            "type": "object",
            "additionalProperties": true
          },
          "target_identity": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "source_identity",
          "target_identity"
        ],
        "additionalProperties": false
      },
      "object_input": {
        "type": "object",
        "description": "新建对象实例时的新对象属性值；不查询或扫描已有实例。",
        "additionalProperties": true
      }
    },
    "required": [
      "kn_id",
      "at_id"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "headers": {
        "type": "object",
        "description": "返回的 Header 信息",
        "additionalProperties": true
      },
      "_dynamic_tools": {
        "type": "array",
        "description": "动态工具定义列表。每项含 parameters（入参 schema，动态参数在 parameters.properties.dynamic_params 下）；工具声明了输出契约时还含 output_schema，即执行成功后 result 字段的形状，用它把执行结果复述成自然语言。",
        "items": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
