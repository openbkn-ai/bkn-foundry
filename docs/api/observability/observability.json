{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "OpenBKN Log Query API",
    "version": "0.1.3-r6.2",
    "description": "Machine contract implemented in OpenBKN 0.1.3 for operation-audit log lists, details, source health, the source inventory, and read-only policies. Log export, high-risk governance writes, per-record quarantine access, and compliance_grade are not yet part of this contract."
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "x-openbkn-authorization-model": {
    "decision_owner": "observability-gateway",
    "identity_and_role_scope_owner": "bkn-safe",
    "role_model": "current_builtin_roles_only",
    "access_profile_capabilities": [
      "business_provenance_own",
      "business_provenance_managed_networks",
      "technical_trace",
      "security_audit",
      "management_audit",
      "global_log_search",
      "allowed_log_categories",
      "log_sensitive_fields",
      "log_export",
      "log_policy_read"
    ],
    "access_scope_fingerprint_owner": "observability-gateway",
    "managed_knowledge_network_scope_source": "BKN Safe GET /api/safe/v1/me/knowledge-network-grants (current-subject direct instance grants only)",
    "access_scope_inputs": [
      "account_status",
      "current_builtin_roles",
      "effective_subject",
      "application_principal",
      "managed_knowledge_network_ids"
    ],
    "source_resource_reauthorization": false,
    "wildcard_grants_satisfy_content_access": false,
    "explicit_scope_types": [
      "platform",
      "environment",
      "record",
      "application",
      "knowledge_network",
      "field"
    ],
    "protected_surfaces": [
      "log_content",
      "sensitive_fields",
      "exports"
    ]
  },
  "paths": {
    "/api/observability/v1/logs": {
      "get": {
        "operationId": "listObservabilityLogs",
        "description": "Lists operation-audit records. The legacy technical-log parameters module, severity_min, services, environments, event_names, resource_type, resource_id, span_id and failed_only are rejected with 400 invalid_log_filter. The time window may not exceed 30 days.",
        "parameters": [
          {
            "$ref": "#/components/parameters/TimeFrom"
          },
          {
            "$ref": "#/components/parameters/TimeTo"
          },
          {
            "name": "q",
            "in": "query",
            "description": "Free-text query (at most 512 characters).",
            "schema": {
              "type": "string",
              "maxLength": 512
            }
          },
          {
            "name": "business_module",
            "in": "query",
            "description": "Registered business module. Unregistered values return 400 invalid_log_filter.",
            "schema": {
              "type": "string",
              "enum": [
                "domain_knowledge_network",
                "observability",
                "execution_factory",
                "data_resource_knowledge_network",
                "model_management",
                "system_management"
              ]
            }
          },
          {
            "name": "source_id",
            "in": "query",
            "description": "Filters records by registered source identifier.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "action",
            "in": "query",
            "description": "Filters by operation action (facts.action).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "target_type",
            "in": "query",
            "description": "Filters by operation target type (facts.target_type).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "target_id",
            "in": "query",
            "description": "Filters by operation target identifier (facts.target_id).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "outcomes",
            "in": "query",
            "description": "Outcome filter. Accepts repeated parameters and/or comma-separated values.",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/Outcome"
              }
            }
          },
          {
            "name": "categories",
            "in": "query",
            "description": "Log category filter. Accepts repeated parameters and/or comma-separated values.",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/LogCategory"
              }
            }
          },
          {
            "name": "actor_id",
            "in": "query",
            "description": "Filters by actor identifier.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "actor",
            "in": "query",
            "description": "Actor name query.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "application_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/ConversationId"
          },
          {
            "$ref": "#/components/parameters/InteractionId"
          },
          {
            "$ref": "#/components/parameters/OperationId"
          },
          {
            "$ref": "#/components/parameters/RequestId"
          },
          {
            "$ref": "#/components/parameters/TraceId"
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque continuation token from next_cursor. Takes precedence over page.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "One-based page number. A single audit-ledger source supports direct page jumps. Cursor-only or mixed sources retain pages 1–100; deeper jumps return 400 pagination_not_supported. A supplied cursor takes precedence over page.",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50,
              "minimum": 20,
              "maximum": 200
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Alias for page_size. If both are present, page_size takes precedence; both supplied values must be valid.",
            "schema": {
              "type": "integer",
              "default": 50,
              "minimum": 20,
              "maximum": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Complete or partial success. partial=true when some sources fail.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogListEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/AccessDenied"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "409": {
            "$ref": "#/components/responses/CursorStale"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/SourcesUnavailable"
          }
        }
      }
    },
    "/api/observability/v1/logs/{event_id}": {
      "get": {
        "operationId": "getObservabilityLog",
        "description": "Returns one operation-audit record by event_id. client_ip is returned only for audit.security records when the caller holds the log_sensitive_fields capability; otherwise it is withheld, and listed in field_projection.redacted_fields only when the record actually carried a client_ip.",
        "parameters": [
          {
            "name": "event_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Details filtered by category, scope, and field permissions.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogDetailEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "invalid_event_id: event_id is empty or contains a slash.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/AccessDenied"
          },
          "404": {
            "$ref": "#/components/responses/NotDisclosed"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/SourcesUnavailable"
          }
        }
      }
    },
    "/api/observability/v1/log-sources": {
      "get": {
        "operationId": "listObservabilityLogSources",
        "responses": {
          "200": {
            "description": "Returns only sources visible to the current subject. Requires the global_log_search capability.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SourceStatus"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/AccessDenied"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/SourcesUnavailable"
          }
        }
      }
    },
    "/api/observability/v1/log-source-inventory": {
      "get": {
        "operationId": "listObservabilityLogSourceInventory",
        "description": "Returns the pinned source registry roster. A caller without the global_log_search capability still receives 200 with every entry marked query_unavailable; 403 here comes only from the access-profile layer.",
        "responses": {
          "200": {
            "description": "Returns the pinned source registry roster with each source's current query status.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "registry_version",
                    "data"
                  ],
                  "properties": {
                    "registry_version": {
                      "type": "string"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "source_id",
                          "owner",
                          "modules",
                          "declared_collection_method",
                          "declared_reliability",
                          "query_status",
                          "coverage_status"
                        ],
                        "properties": {
                          "source_id": {
                            "type": "string"
                          },
                          "owner": {
                            "type": "string"
                          },
                          "modules": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "declared_collection_method": {
                            "type": "string"
                          },
                          "declared_reliability": {
                            "type": "string"
                          },
                          "query_status": {
                            "type": "string",
                            "description": "Current query status of the matching visible source (a SourceStatus.status value), not_listed when no visible source matches, or query_unavailable when the source query failed or the caller lacks the global_log_search capability (this route still answers 200 in that case)."
                          },
                          "query_reason": {
                            "type": "string"
                          },
                          "coverage_status": {
                            "type": "string",
                            "description": "Always unverified: a declared method is never reported as end-to-end coverage."
                          }
                        },
                        "additionalProperties": false
                      }
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/AccessDenied"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "description": "source_registry_unavailable (the embedded registry cannot be read) or sources_unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/observability/v1/log-policies": {
      "get": {
        "operationId": "listObservabilityLogPolicies",
        "responses": {
          "200": {
            "description": "Returns the authorized projection of ordinary-log and audit policies. Requires the log_policy_read capability.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/LogPolicy"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/AccessDenied"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/SourcesUnavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "parameters": {
      "TimeFrom": {
        "name": "time_from",
        "in": "query",
        "description": "RFC3339 timestamp, inclusive boundary. When omitted, the window defaults to the 30 days before time_to (or now); correlation drill-downs by conversation_id, interaction_id, operation_id, request_id or trace_id default to 7 days. time_to must not precede time_from and the window may not exceed 30 days.",
        "schema": {
          "type": "string",
          "format": "date-time"
        }
      },
      "TimeTo": {
        "name": "time_to",
        "in": "query",
        "description": "RFC3339 timestamp, exclusive boundary. Defaults to now.",
        "schema": {
          "type": "string",
          "format": "date-time"
        }
      },
      "ConversationId": {
        "name": "conversation_id",
        "in": "query",
        "schema": {
          "type": "string"
        }
      },
      "InteractionId": {
        "name": "interaction_id",
        "in": "query",
        "schema": {
          "type": "string"
        }
      },
      "OperationId": {
        "name": "operation_id",
        "in": "query",
        "schema": {
          "type": "string"
        }
      },
      "RequestId": {
        "name": "request_id",
        "in": "query",
        "schema": {
          "type": "string"
        }
      },
      "TraceId": {
        "name": "trace_id",
        "in": "query",
        "schema": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        }
      }
    },
    "schemas": {
      "LogCategory": {
        "type": "string",
        "enum": [
          "access.user",
          "audit.admin",
          "audit.security",
          "runtime.business",
          "runtime.model"
        ]
      },
      "AuditLogCategory": {
        "type": "string",
        "enum": [
          "access.user",
          "audit.admin",
          "audit.security"
        ]
      },
      "RuntimeLogCategory": {
        "type": "string",
        "enum": [
          "runtime.business",
          "runtime.model"
        ]
      },
      "Outcome": {
        "type": "string",
        "enum": [
          "success",
          "failure",
          "denied",
          "canceled",
          "unknown"
        ]
      },
      "Reliability": {
        "type": "string",
        "enum": [
          "best_effort",
          "durable"
        ]
      },
      "SourceState": {
        "type": "string",
        "enum": [
          "healthy",
          "delayed",
          "partial",
          "degraded",
          "unavailable",
          "not_integrated"
        ]
      },
      "OperationAuditRecord": {
        "type": "object",
        "description": "Public operation-audit record.",
        "required": [
          "schema_version",
          "event_id",
          "log_category",
          "event_name",
          "event_time",
          "recorded_at",
          "actor_id",
          "actor_name_snapshot",
          "auth_method",
          "source_channel",
          "source_id",
          "business_module",
          "outcome",
          "facts",
          "correlation",
          "attributes"
        ],
        "properties": {
          "schema_version": {
            "type": "string"
          },
          "event_id": {
            "type": "string"
          },
          "log_category": {
            "$ref": "#/components/schemas/LogCategory"
          },
          "event_name": {
            "type": "string"
          },
          "event_time": {
            "type": "string",
            "format": "date-time"
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          },
          "actor_id": {
            "type": "string"
          },
          "actor_name_snapshot": {
            "type": "string"
          },
          "actor_type": {
            "type": "string"
          },
          "auth_method": {
            "type": "string"
          },
          "credential_id": {
            "type": "string"
          },
          "credential_name": {
            "type": "string"
          },
          "source_channel": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "business_module": {
            "type": "string"
          },
          "outcome": {
            "$ref": "#/components/schemas/Outcome"
          },
          "failure_code": {
            "type": "string"
          },
          "failure_message": {
            "type": "string"
          },
          "facts": {
            "$ref": "#/components/schemas/OperationAuditFacts"
          },
          "correlation": {
            "$ref": "#/components/schemas/OperationAuditCorrelation"
          },
          "attributes": {
            "type": "object",
            "description": "Source-specific extension attributes not promoted to facts.",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      },
      "OperationAuditFacts": {
        "type": "object",
        "required": [
          "action",
          "target_type",
          "target_id",
          "target_name_snapshot"
        ],
        "properties": {
          "action": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "status_code": {
            "type": "integer"
          },
          "client_ip": {
            "type": "string",
            "description": "Omitted from list responses; in detail responses only for audit.security records when the caller holds log_sensitive_fields."
          },
          "target_type": {
            "type": "string"
          },
          "target_id": {
            "type": "string"
          },
          "target_name_snapshot": {
            "type": "string"
          },
          "detail": {
            "type": "object",
            "additionalProperties": true
          },
          "operation_type": {
            "type": "string"
          },
          "operation_status": {
            "type": "string"
          },
          "business_context": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "OperationAuditCorrelation": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string"
          },
          "trace_id": {
            "type": "string"
          },
          "span_id": {
            "type": "string"
          },
          "conversation_id": {
            "type": "string"
          },
          "interaction_id": {
            "type": "string"
          },
          "operation_id": {
            "type": "string"
          },
          "task_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "SourceStatus": {
        "type": "object",
        "required": [
          "source_id",
          "status",
          "reliability",
          "last_received_at",
          "watermark",
          "latency_ms"
        ],
        "properties": {
          "status_scope": {
            "type": "string",
            "description": "Scope the status describes; query for the audit ledger."
          },
          "collection_status": {
            "$ref": "#/components/schemas/AuditCollectionStatus"
          },
          "source_id": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/SourceState"
          },
          "reason": {
            "type": "string"
          },
          "required_action": {
            "type": "string",
            "description": "Deployment action required to configure this source. A disabled audit-ledger reports status=not_integrated and reason=audit_consumer_not_configured."
          },
          "reliability": {
            "$ref": "#/components/schemas/Reliability"
          },
          "last_received_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "watermark": {
            "type": [
              "string",
              "null"
            ]
          },
          "latency_ms": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "collection_method": {
            "type": "string",
            "enum": [
              "direct_otlp",
              "container_stdout",
              "source_adapter",
              "kafka_audit",
              "projection_outbox",
              "not_integrated"
            ]
          },
          "covered_modules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dropped_records": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "dropped_records_since": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Start of the observed dropped-record counter window."
          },
          "sampling_rate": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "sampled_records": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "count_accuracy": {
            "type": "string",
            "enum": [
              "exact",
              "sampled",
              "partial",
              "unavailable"
            ]
          }
        },
        "dependentRequired": {
          "dropped_records": [
            "dropped_records_since"
          ],
          "dropped_records_since": [
            "dropped_records"
          ]
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "collection_method": {
                  "const": "kafka_audit"
                }
              },
              "required": [
                "collection_method"
              ]
            },
            "then": {
              "required": [
                "dropped_records",
                "dropped_records_since"
              ],
              "oneOf": [
                {
                  "properties": {
                    "dropped_records": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "dropped_records_since": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                },
                {
                  "properties": {
                    "dropped_records": {
                      "type": "null"
                    },
                    "dropped_records_since": {
                      "type": "null"
                    }
                  }
                }
              ]
            }
          }
        ],
        "additionalProperties": false
      },
      "AuditCollectionStatus": {
        "type": "object",
        "description": "Observed publisher metadata for one configured Safe instance; not proof of complete collection. Null values mean unknown.",
        "required": [
          "scope",
          "status",
          "reason",
          "observed_at",
          "last_delivered_at",
          "last_failure_at",
          "dropped_records",
          "historical_gap",
          "historical_gap_since"
        ],
        "properties": {
          "scope": {
            "type": "string"
          },
          "instance_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "unknown",
              "healthy",
              "degraded"
            ]
          },
          "reason": {
            "type": "string"
          },
          "observed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "last_delivered_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "last_failure_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "dropped_records": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "historical_gap": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "historical_gap_since": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "Count": {
        "type": "object",
        "required": [
          "value",
          "accuracy"
        ],
        "properties": {
          "value": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "accuracy": {
            "type": "string",
            "enum": [
              "exact",
              "partial"
            ]
          }
        },
        "additionalProperties": false
      },
      "LogListEnvelope": {
        "type": "object",
        "required": [
          "data",
          "next_cursor",
          "partial",
          "count",
          "pagination",
          "source_status",
          "request_trace_context"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OperationAuditRecord"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "partial": {
            "type": "boolean"
          },
          "count": {
            "$ref": "#/components/schemas/Count"
          },
          "pagination": {
            "type": "object",
            "required": ["page", "page_size"],
            "properties": {
              "page": { "type": "integer", "minimum": 1 },
              "page_size": { "type": "integer", "minimum": 20, "maximum": 200 }
            },
            "additionalProperties": false
          },
          "source_status": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceStatus"
            }
          },
          "request_trace_context": {
            "$ref": "#/components/schemas/RequestTraceContext"
          }
        },
        "additionalProperties": false
      },
      "LogDetailEnvelope": {
        "type": "object",
        "required": [
          "data",
          "field_projection",
          "request_trace_context"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/OperationAuditRecord"
          },
          "field_projection": {
            "type": "object",
            "required": [
              "policy_revision",
              "redacted_fields"
            ],
            "properties": {
              "policy_revision": {
                "type": "string"
              },
              "redacted_fields": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "request_trace_context": {
            "$ref": "#/components/schemas/RequestTraceContext"
          }
        },
        "additionalProperties": false
      },
      "LogPolicy": {
        "type": "object",
        "required": [
          "scope",
          "policy_revision",
          "category",
          "retention_days",
          "policy_kind",
          "legal_hold"
        ],
        "properties": {
          "scope": {
            "type": "object",
            "description": "Policy scope selector. Currently always an empty object (platform-wide default policy).",
            "additionalProperties": {
              "type": "string"
            }
          },
          "policy_revision": {
            "type": "string"
          },
          "category": {
            "$ref": "#/components/schemas/LogCategory"
          },
          "retention_days": {
            "type": "integer",
            "minimum": 1
          },
          "policy_kind": {
            "type": "string",
            "enum": [
              "runtime",
              "audit"
            ]
          },
          "legal_hold": {
            "type": "boolean"
          },
          "storage_target_ref": {
            "type": "string"
          }
        },
        "oneOf": [
          {
            "properties": {
              "policy_kind": {
                "const": "runtime"
              },
              "category": {
                "$ref": "#/components/schemas/RuntimeLogCategory"
              }
            },
            "required": [
              "policy_kind",
              "category"
            ]
          },
          {
            "properties": {
              "policy_kind": {
                "const": "audit"
              },
              "category": {
                "$ref": "#/components/schemas/AuditLogCategory"
              }
            },
            "required": [
              "policy_kind",
              "category"
            ]
          }
        ],
        "additionalProperties": false
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "retryable",
              "request_id"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              },
              "required_action": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "request_id": {
                "type": "string"
              },
              "retry_after_ms": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "RequestTraceContext": {
        "type": "object",
        "required": [
          "request_id",
          "related_trace_ids"
        ],
        "properties": {
          "request_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "current_trace_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{32}$"
          },
          "related_trace_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "responses": {
      "BadRequest": {
        "description": "invalid_log_filter (malformed or unsupported parameter, legacy technical-log parameter, or time window longer than 30 days), cursor_invalid, or pagination_not_supported (numbered jumps beyond page 100 for cursor-only or mixed sources).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "CursorStale": {
        "description": "The access_scope_fingerprint, visible source set, or query contract changed. Restart from the first page.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "NotDisclosed": {
        "description": "The record does not exist or cannot be disclosed to the current subject. Returns log_not_disclosed in both cases to prevent enumeration.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "SourcesUnavailable": {
        "description": "code=sources_unavailable (all authorized sources failed, or the log query service is not configured), retryable=true. If the only authorized source is an unconfigured audit-ledger: code=audit_consumer_not_configured, retryable=false, with required_action describing the Helm configuration. Mixed queries retain available records, report the audit configuration gap in source_status, and mark results partial. Authentication infrastructure failures return query_oauth_unavailable or query_auth_not_configured.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "AuthenticationRequired": {
        "description": "Authentication is missing or invalid; code is query_oauth_required, query_identity_required, query_identity_mismatch, or query_access_denied (the account and record scope could not be authorized).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "MethodNotAllowed": {
        "description": "Only GET is supported; code=method_not_allowed.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "InternalError": {
        "description": "code=log_query_failed, retryable=true.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "AccessDenied": {
        "description": "The access profile lacks the capability or category access required by this operation; code=observability_access_denied.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      }
    }
  }
}
