{
  "conponentDefineType": "helm/service",
  "name": "mf-model-manager",
  "version": "1.0.0",
  "configSchema": {
    "title": "mf-model-manager",
    "description": "Component configuration definition",
    "type": "object",
    "properties": {
      "resources": {
        "type": "object",
        "title": "Container Resource Control",
        "properties": {
          "requests": {
            "type": "object",
            "description": "Minimum resource allocation required by the container",
            "properties": {
              "memory": {
                "type": "string",
                "title": "Memory"
              },
              "cpu": {
                "type": "string",
                "title": "cpu"
              }
            }
          },
          "limits": {
            "type": "object",
            "description": "Maximum resource limits for the container",
            "properties": {
              "memory": {
                "type": "string",
                "title": "Memory"
              },
              "cpu": {
                "type": "string",
                "title": "cpu"
              }
            }
          },
        "text_vector_mapping": {
            "type": "object",
            "description": "Text vector mapping",
            "properties": {
              "content": {
                "type": "string",
                "title": "Mapping rule"
              }
            }
          },
        "vlm_vector_mapping": {
            "type": "object",
            "description": "Multimodal vector mapping",
            "properties": {
              "content": {
                "type": "string",
                "title": "Mapping rule"
              }
            }
          },
        "text_reranker_mapping": {
            "type": "object",
            "description": "Text semantic similarity reranking mapping",
            "properties": {
              "content": {
                "type": "string",
                "title": "Mapping rule"
              }
            }
          }
        }
      },
      "observability": {
        "type": "object",
        "title": "Observability Configuration",
        "properties": {
            "logEnabled" : {
                "type": "string",
                "title": "Whether to report logs to the data platform; only true or false is accepted"
            }
        }
    },
      "replicaCount": {
        "type": "number",
        "title": "Service Replica Count"
      }
    }
  },
  "dependence": [
    {
      "name": "rds"
    },
    {
      "name": "opensearch"
    },
    {
      "name": "model-management-dm-pre"
    },
    {
      "name": "redis"
    },
    {
      "name": "mq"
    }
  ]
}
