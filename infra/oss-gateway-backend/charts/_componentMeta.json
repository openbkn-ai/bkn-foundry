{
  "conponentDefineType": "helm/service",
  "name": "oss-gateway-backend",
  "version": "1.0.0",
  "configSchema": {
    "title": "oss-gateway-backend",
    "description": "Component configuration schema",
    "type": "object",
    "properties": {
      "resources": {
        "type": "object",
        "title": "Container resources",
        "properties": {
          "requests": {
            "type": "object",
            "description": "Minimum resources required by the container",
            "properties": {
              "memory": {
                "type": "string",
                "title": "Memory"
              },
              "cpu": {
                "type": "string",
                "title": "cpu"
              }
            }
          },
          "limits": {
            "type": "object",
            "description": "Maximum resources available to the container",
            "properties": {
              "memory": {
                "type": "string",
                "title": "Memory"
              },
              "cpu": {
                "type": "string",
                "title": "cpu"
              }
            }
          },
        "text_vector_mapping": {
            "type": "object",
            "description": "Text vector mapping",
            "properties": {
              "content": {
                "type": "string",
                "title": "Mapping rule"
              }
            }
          },
        "vlm_vector_mapping": {
            "type": "object",
            "description": "Multimodal vector mapping",
            "properties": {
              "content": {
                "type": "string",
                "title": "Mapping rule"
              }
            }
          },
        "text_reranker_mapping": {
            "type": "object",
            "description": "Text semantic-similarity reranker mapping",
            "properties": {
              "content": {
                "type": "string",
                "title": "Mapping rule"
              }
            }
          }
        }
      },
      "observability": {
        "type": "object",
        "title": "Observability configuration",
        "properties": {
            "logEnabled" : {
                "type": "string",
                "title": "Whether to send logs to the data platform; accepts true or false"
            }
        }
    },
      "replicaCount": {
        "type": "number",
        "title": "Service replica count"
      }
    }
  },
  "dependence": [
    {
      "name": "rds"
    },
    {
      "name": "opensearch"
    },
    {
      "name": "model-management-dm-pre"
    },
    {
      "name": "redis"
    },
    {
      "name": "mq"
    }
  ]
}
